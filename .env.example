# Optional: Supabase Database Configuration (PostgreSQL)
# When set, the application can connect directly to your cloud Supabase database.
# When omitted, the built-in centralized local store is used automatically.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Google Gemini API Key for Natural Language Billing Parsing
# When omitted, the built-in intelligent rule-based accessories parser runs automatically.
GEMINI_API_KEY=your-gemini-api-key
